// 「补位」AI 项目办公室 — 后端 Worker 配置
// 本地开发使用顶层默认配置（wrangler dev / vitest 均以本地模拟运行 D1、R2）。
// staging / production 的资源 ID 由负责人创建真实资源后填入（见 docs/DEPLOY.md）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenbp-team-office-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-office-db-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ai-office-files-local" }],
  "workflows": [
    {
      "binding": "PARSE_WORKFLOW",
      "name": "ai-office-parse",
      "class_name": "ParseSourceWorkflow"
    },
    {
      "binding": "AGENT_WORKFLOW",
      "name": "ai-office-agent",
      "class_name": "AgentRunWorkflow"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENV_NAME": "local",
    "EMAIL_MODE": "echo",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": ""
  },
  "env": {
    "staging": {
      "name": "ai-office-api-staging",
      "vars": {
        "ENV_NAME": "staging",
        "EMAIL_MODE": "resend",
        "ALLOWED_ORIGINS": "",
        "CLOUDFLARE_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-office-db-staging",
          "database_id": "<STAGING_D1_ID>",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ai-office-files-staging" }],
      "workflows": [
        {
          "binding": "PARSE_WORKFLOW",
          "name": "ai-office-parse-staging",
          "class_name": "ParseSourceWorkflow"
        },
        {
          "binding": "AGENT_WORKFLOW",
          "name": "ai-office-agent-staging",
          "class_name": "AgentRunWorkflow"
        }
      ]
    },
    "production": {
      "name": "greenbp-team-office-backend",
      "vars": {
        "ENV_NAME": "production",
        "EMAIL_MODE": "resend",
        "ALLOWED_ORIGINS": "https://team.greenbp.dpdns.org,https://greenbp-team-office.hddhp.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "17a6817bca6612a9cb11d0395eeba0ac",
        "AI_GATEWAY_ID": "",
        "EMAIL_FROM": "补位 AI 项目办公室 <login@auth.greenbp.dpdns.org>",
        "AUTH_MODE": "invite-only",
        "EMAIL_DAILY_LIMIT": "30",
        "TURNSTILE_REQUIRED": "false",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFKQSg4fWagOtFAC"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-office-db-production",
          "database_id": "2a65957e-9138-4c39-be40-156c1756e037",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ai-office-files-production" }],
      "workflows": [
        {
          "binding": "PARSE_WORKFLOW",
          "name": "greenbp-team-office-parse",
          "class_name": "ParseSourceWorkflow"
        },
        {
          "binding": "AGENT_WORKFLOW",
          "name": "greenbp-team-office-agent",
          "class_name": "AgentRunWorkflow"
        }
      ]
    }
  }
}
