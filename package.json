{
  "name": "ai-office",
  "private": true,
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "build": "npm run build --prefix frontend",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "test:frontend": "npm test --prefix frontend",
    "preflight:deploy": "node scripts/preflight-deploy.mjs",
    "backup:drill:local": "node scripts/backup-drill-local.mjs",
    "bootstrap:admin:local": "node scripts/bootstrap-password-admin.mjs --local",
    "bootstrap:admin:production": "node scripts/bootstrap-password-admin.mjs --production"
  }
}
